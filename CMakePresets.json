{
  "version": 4,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "msvc-debug",
      "displayName": "MSVC (Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/dist/msvc-debug",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "architecture": { "value": "x64", "strategy": "external" },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "msvc-release",
      "inherits": "msvc-debug",
      "displayName": "MSVC (Release)",
      "binaryDir": "${sourceDir}/dist/msvc-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "mingw-debug",
      "displayName": "MinGW / Wine (Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/dist/mingw-debug",
      "toolchainFile": "${sourceDir}/toolchains/mingw-w64.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "mingw-release",
      "inherits": "mingw-debug",
      "displayName": "MinGW / Wine (Release)",
      "binaryDir": "${sourceDir}/dist/mingw-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "mingw-clang-debug",
      "displayName": "MSYS2 Clang / MinGW (Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/dist/mingw-clang-debug",
      "toolchainFile": "${sourceDir}/toolchains/mingw-clang.cmake",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "mingw-clang-release",
      "inherits": "mingw-clang-debug",
      "displayName": "MSYS2 Clang / MinGW (Release)",
      "binaryDir": "${sourceDir}/dist/mingw-clang-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "host-debug",
      "displayName": "stars-host with the native compiler (Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/dist/host-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "host-release",
      "inherits": "host-debug",
      "displayName": "stars-host with the native compiler (Release)",
      "binaryDir": "${sourceDir}/dist/host-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "macos-host-debug",
      "inherits": "host-debug",
      "displayName": "stars-host for x86_64 macOS, run by Rosetta on Apple silicon (Debug)",
      "binaryDir": "${sourceDir}/dist/macos-host-debug",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "x86_64"
      }
    },
    {
      "name": "macos-host-release",
      "inherits": "macos-host-debug",
      "displayName": "stars-host for x86_64 macOS, run by Rosetta on Apple silicon (Release)",
      "binaryDir": "${sourceDir}/dist/macos-host-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "msvc-debug",
      "displayName": "Build stars.exe and stars-host.exe (MSVC Debug)",
      "configurePreset": "msvc-debug"
    },
    {
      "name": "msvc-release",
      "displayName": "Build stars.exe and stars-host.exe (MSVC Release)",
      "configurePreset": "msvc-release"
    },
    {
      "name": "mingw-debug",
      "displayName": "Build stars.exe (MinGW Debug)",
      "configurePreset": "mingw-debug"
    },
    {
      "name": "mingw-release",
      "displayName": "Build stars.exe (MinGW Release)",
      "configurePreset": "mingw-release"
    },
    {
      "name": "mingw-clang-debug",
      "displayName": "Build stars.exe and stars-host.exe (Clang MinGW Debug)",
      "configurePreset": "mingw-clang-debug"
    },
    {
      "name": "mingw-clang-release",
      "displayName": "Build stars.exe and stars-host.exe (Clang MinGW Release)",
      "configurePreset": "mingw-clang-release"
    },
    {
      "name": "run-wine",
      "displayName": "Run stars.exe in Wine",
      "configurePreset": "mingw-debug",
      "targets": [
        "run_in_wine"
      ]
    },
    {
      "name": "host-debug",
      "displayName": "Build stars-host (native Debug)",
      "configurePreset": "host-debug"
    },
    {
      "name": "host-release",
      "displayName": "Build stars-host (native Release)",
      "configurePreset": "host-release"
    },
    {
      "name": "macos-host-debug",
      "displayName": "Build stars-host (x86_64 macOS Debug)",
      "configurePreset": "macos-host-debug"
    },
    {
      "name": "macos-host-release",
      "displayName": "Build stars-host (x86_64 macOS Release)",
      "configurePreset": "macos-host-release"
    }
  ]
}
